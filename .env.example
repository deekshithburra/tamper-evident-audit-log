# ---------------------------------------------------------------- Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- Storage
# File path, or ":memory:" for an ephemeral database
DATABASE_PATH=./data/audit.db

# ---------------------------------------------------------------- Domain policy
# How far a caller-supplied occurredAt may drift from server time
MAX_CLOCK_SKEW_MS=300000
# Records older than this are eligible for archival
RETENTION_WINDOW_DAYS=365

# ---------------------------------------------------------------- Credentials (simple form)
# Comma-separated "secret:role" pairs. Roles: writer | reader | auditor | admin
# Produces non-expiring, unscoped credentials - fine locally, REFUSED in production.
API_KEYS=dev-writer-key:writer,dev-reader-key:reader,dev-auditor-key:auditor,dev-admin-key:admin

# ---------------------------------------------------------------- Credentials (full form)
# JSON array with lifecycle and object-level scope. Takes precedence over API_KEYS.
# Fields: id, secret, role, notBefore?, expiresAt?, revokedAt?, scope?, description?
#
# `scope` is the BOLA control: an allow-list over actorIds / resourceTypes / resourceIds.
# An absent dimension is unrestricted; a credential with no scope sees everything.
#
# Two entries may share an `id` - that is how a zero-downtime rotation is expressed:
# same principal, two live secrets, overlapping validity windows.
#
# API_CREDENTIALS=[
#   {"id":"svc-web","secret":"...","role":"writer","expiresAt":"2026-12-01T00:00:00.000Z",
#    "description":"Web tier event producer"},
#   {"id":"desk-west","secret":"...","role":"auditor","expiresAt":"2026-12-01T00:00:00.000Z",
#    "scope":{"resourceIds":["client-100","client-101"]},
#    "description":"West desk: may only see its own clients"},
#   {"id":"svc-web","secret":"...","role":"writer","notBefore":"2026-11-24T00:00:00.000Z",
#    "expiresAt":"2027-02-01T00:00:00.000Z","description":"svc-web rotation: incoming secret"}
# ]

# Credentials expiring within this many days are flagged rotation-due (header + inventory)
CREDENTIAL_ROTATION_WARNING_DAYS=14
# Maximum permitted credential lifetime. Enforced at boot in production.
MAX_CREDENTIAL_LIFETIME_DAYS=90

# ---------------------------------------------------------------- Rate limiting
# Keyed by credential, not by IP: every caller is a server behind shared egress.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_WRITE=1200
RATE_LIMIT_MAX_READ=600
# Verify, export and reporting walk the whole chain, so they get their own small budget.
RATE_LIMIT_MAX_EXPENSIVE=30

# ---------------------------------------------------------------- Pagination
MAX_PAGE_SIZE=200
DEFAULT_PAGE_SIZE=50
