# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Storage: file path, or ":memory:" for an ephemeral database
DATABASE_PATH=./data/audit.db

# Timestamp policy: how far a caller-supplied occurredAt may drift from server time
MAX_CLOCK_SKEW_MS=300000

# Retention: records older than this are eligible for archival (days)
RETENTION_WINDOW_DAYS=365

# API keys: comma-separated "key:role" pairs.
# Roles: writer | reader | auditor | admin
# NOTE: development defaults only. Provision real secrets from a secret manager.
API_KEYS=dev-writer-key:writer,dev-reader-key:reader,dev-auditor-key:auditor,dev-admin-key:admin
